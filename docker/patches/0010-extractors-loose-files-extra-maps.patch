+
+#ifndef ExtraMaps_h__
+#define ExtraMaps_h__
+
+// Maps that are not in the build's Map.db2 (the client gets them by hotfix), and a filter to extract only some maps.
+//
+//   EXTRACTOR_EXTRA_MAPS="530:828395:Expansion01[:parentMapId],..."  id, WDT FileDataID, directory, optional parent
+//   EXTRACTOR_ONLY_MAPS="530,..."                                   extract only these maps (empty: all maps)
+//
+// The WDT and ADTs of such a map usually are not in the build either: see EXTRACTOR_LOOSE_FILES in CascHandles.cpp.
+
+#include "Define.h"
+#include <cstdio>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+struct ExtraMapEntry
+{
+    uint32 Id = 0;
+    int32 WdtFileDataId = 0;
+    int16 ParentMapID = -1;
+    std::string Directory;
+};
+
+inline std::vector<ExtraMapEntry> GetExtraMapsFromEnv()
+{
+    std::vector<ExtraMapEntry> maps;
+    char const* env = std::getenv("EXTRACTOR_EXTRA_MAPS");
+    if (!env || !*env)
+        return maps;
+
+    std::stringstream list(env);
+    std::string item;
+    while (std::getline(list, item, ','))
+    {
+        if (item.empty())
+            continue;
+
+        std::vector<std::string> parts;
+        std::stringstream fields(item);
+        std::string field;
+        while (std::getline(fields, field, ':'))
+            parts.push_back(field);
+
+        if (parts.size() < 3 || parts.size() > 4)
+        {
+            printf("EXTRACTOR_EXTRA_MAPS: ignoring '%s' (want id:wdtFileDataID:Directory[:parentMapId])\n", item.c_str());
+            continue;
+        }
+
+        ExtraMapEntry& map = maps.emplace_back();
+        map.Id = uint32(std::strtoul(parts[0].c_str(), nullptr, 10));
+        map.WdtFileDataId = int32(std::strtol(parts[1].c_str(), nullptr, 10));
+        map.Directory = parts[2];
+        if (parts.size() == 4)
+            map.ParentMapID = int16(std::strtol(parts[3].c_str(), nullptr, 10));
+    }
+
+    return maps;
+}
+
+// empty when every map should be extracted
+inline std::unordered_set<uint32> GetOnlyMapsFromEnv()
+{
+    std::unordered_set<uint32> ids;
+    char const* env = std::getenv("EXTRACTOR_ONLY_MAPS");
+    if (!env || !*env)
+        return ids;
+
+    std::stringstream list(env);
+    std::string item;
+    while (std::getline(list, item, ','))
+        if (!item.empty())
+            ids.insert(uint32(std::strtoul(item.c_str(), nullptr, 10)));
+
+    return ids;
+}
+
+#endif // ExtraMaps_h__
