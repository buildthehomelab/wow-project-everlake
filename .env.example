# Copy to .env and adjust. (No ' or " in the passwords.)

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=trinity
DB_PASSWORD=change-me-trinity
MYSQL_BUFFER_POOL=512M

# Address the players use to reach the server. Mac players on the LAN: 127.0.0.1 (see docs/client-connection.md,
# Local Network permission: their forwarder passes 127.0.0.1 on to this server).
# Otherwise:
#   127.0.0.1 = this machine only; LAN IP = local network; public IP or DNS name = internet.
#   A DNS name (e.g. forever.realm.example.com) is looked up by the login server, which hands players the address.
PUBLIC_ADDRESS=127.0.0.1
REALM_LOCAL_ADDRESS=127.0.0.1
REALM_LOCAL_SUBNET_MASK=255.255.255.0
REALM_NAME=Everlake
# Realm 1's world port. Change it when the host already runs a game server on 8085 (Evermore on Patronus: 8086)
WORLD_PORT=8085

# Client build the server accepts. Empty = only the build the pinned core supports (1.60.1.70790).
CLIENT_BUILD=

# Build: core commit (advocaite/TrinityCore, forever branch) and parallel compile jobs (~2 GB of RAM per job)
TC_COMMIT=6ac7bece2e7a6b3f75599f20d62235985ea78a7d
BUILD_JOBS=4

# Game data extraction (docker compose run --rm extractor)
#   CASC_REMOTE=1: from Blizzard's CDN (no client install needed); 0: from WOW_DIR
CASC_REMOTE=1
CASC_PRODUCT=wowf
CASC_REGION=us
WOW_DIR=./wow-not-set
EXTRACT_MMAPS=0

# 1 = pathfinding on (needs the mmaps folder in ./data)
MMAP_PATHFINDING=0

TZ=UTC
DATA_DIR=./data

# The name the game logs in at, and its certificate (docs/client-connection.md). Pick ONE of the two setups below
# and uncomment all four of its lines. With every line commented, you get setup A.
#
# A. trinity.actual.battle.net: our own CA from scripts/gen-certs.sh, a hosts entry and the CA on every player's
#    computer. Fine for a test machine.
#LOGIN_HOSTNAME=trinity.actual.battle.net
#CERTS_DIR=./certs
#CERT_FILE=forever.cert.pem
#KEY_FILE=forever.key.pem
#
# B. Our own name: a real DNS record and certificate, nothing for players to install; the client needs the
#    login-name patch (FOREVER_ANY_PORTAL in client/macos/keypatch.c). CERTS_DIR is a host folder holding the
#    certificate's full chain (CERT_FILE) and its key (KEY_FILE), e.g. Let's Encrypt's fullchain.pem and privkey.pem.
#    Real files, not symlinks into another folder (the container can't follow those).
#LOGIN_HOSTNAME=login.realm.example.com
#CERTS_DIR=/path/to/certificate/files
#CERT_FILE=fullchain.pem
#KEY_FILE=privkey.pem

# Patched client build for players' test copies (cdn service, docs/custom-files.md): where cdn-build writes it and the
# port it is served on. Players point their Mac at it with: everlake-client.sh cdn <server>:<port>
#CDN_FILES_DIR=./cdn-files   (file sets to add: folders with files named by FileDataID and a files.tsv)
#CDN_DIR=./cdn
#CDN_PORT=8087
