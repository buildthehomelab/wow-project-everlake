# Copy to .env and adjust. (No ' or " in the passwords.)

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=trinity
DB_PASSWORD=change-me-trinity
MYSQL_BUFFER_POOL=512M

# Address the players use to reach the server:
#   127.0.0.1 = this machine only; LAN IP = local network; public IP or DNS name = internet
PUBLIC_ADDRESS=127.0.0.1
REALM_LOCAL_ADDRESS=127.0.0.1
REALM_LOCAL_SUBNET_MASK=255.255.255.0
REALM_NAME=Everlake

# Client build the server accepts. Empty = only the build the pinned core supports (1.60.1.70790).
CLIENT_BUILD=

# Build: core commit (advocaite/TrinityCore, forever branch) and parallel compile jobs (~2 GB of RAM per job)
TC_COMMIT=6ac7bece2e7a6b3f75599f20d62235985ea78a7d
BUILD_JOBS=4

# Game data extraction (docker compose run --rm extractor)
#   CASC_REMOTE=1: from Blizzard's CDN (no client install needed); 0: from WOW_DIR
CASC_REMOTE=1
CASC_PRODUCT=wowf
CASC_REGION=us
WOW_DIR=./wow-not-set
EXTRACT_MMAPS=0

# 1 = pathfinding on (needs the mmaps folder in ./data)
MMAP_PATHFINDING=0

TZ=UTC
DATA_DIR=./data
CERTS_DIR=./certs
