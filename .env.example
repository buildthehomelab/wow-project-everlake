# Copy to .env and adjust. (No ' or " in the passwords.)

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=trinity
DB_PASSWORD=change-me-trinity
MYSQL_BUFFER_POOL=512M

# Address the players use to reach the server. Mac players on the LAN: 127.0.0.1 (see docs/client-connection.md,
# Local Network permission: their forwarder passes 127.0.0.1 on to this server).
# Otherwise:
#   127.0.0.1 = this machine only; LAN IP = local network; public IP or DNS name = internet.
#   A DNS name (e.g. forever.realm.example.com) is looked up by the login server, which hands players the address.
PUBLIC_ADDRESS=127.0.0.1
REALM_LOCAL_ADDRESS=127.0.0.1
REALM_LOCAL_SUBNET_MASK=255.255.255.0
# Realm 1's name: keep it the same as its ruleset card, Forever (sql/everlake/2026_11_12_00_hotfixes_ruleset_cards.sql)
REALM_NAME=Forever
# Realm 1's world port. Change it when the host already runs a game server on 8085 (for example 8086)
WORLD_PORT=8085

# Experimental: realms to this client build, from an auth file applied after the core's (on an existing database
# only when the value changes, so a new core file still runs and wins). Leave it empty: the pinned core then sets the
# realms to 1.60.1.70862, and bnetserver also lets 70790 clients in. A value set once and later cleared leaves the
# realms on it (the core's 70862 file only moves realms that are on 70634, 70658 or 70790).
CLIENT_BUILD=

# Build: core commit (buildthehomelab/wow-trinitycore-everlake, everlake branch) and parallel compile jobs (~2 GB of RAM per job)
# The same commit and bots the PTR builds (docker-compose.ptr.yml), so either app builds one identical image under a PTR tag.
TC_COMMIT=fdcf518cf9dbd9e1825dbdac24a77c859681794c
# PLAYERBOTS: 1 builds the bots in (the default); 0 builds the core without them
PLAYERBOTS=1
BUILD_JOBS=4

# World import (docs/forever-import.md): a full commit SHA of buildthehomelab/wow-everlake-world-data whose update
# files the worldserver applies on start (after "docker compose build"). Empty: none. The files land in the world
# database, which realm 2 shares, and in the image every worldserver of this project runs: set it only in a project
# with its own world database and its own image (the PTR realm first, then live by scripts/promote.sh). Once a realm has applied the files,
# keep it set; moving it forward is fine (files are never changed once deployed).
WORLD_DATA_COMMIT=
# Game data extraction (docker compose run --rm extractor)
#   CASC_REMOTE=1: from Blizzard's CDN (no client install needed); 0: from WOW_DIR
CASC_REMOTE=1
CASC_PRODUCT=wowf
CASC_REGION=us
WOW_DIR=./wow-not-set
EXTRACT_MMAPS=0

# 1 = pathfinding on (needs the mmaps folder in ./data)
MMAP_PATHFINDING=0

TZ=UTC
DATA_DIR=./data

# The name the game logs in at, and its certificate (docs/client-connection.md). Pick ONE of the two setups below
# and uncomment all four of its lines. With every line commented, you get setup A.
#
# A. trinity.actual.battle.net: our own CA from scripts/gen-certs.sh, a hosts entry and the CA on every player's
#    computer. Fine for a test machine.
#LOGIN_HOSTNAME=trinity.actual.battle.net
#CERTS_DIR=./certs
#CERT_FILE=forever.cert.pem
#KEY_FILE=forever.key.pem
#
# B. Our own name: a real DNS record and certificate, nothing for players to install; the client needs the
#    login-name patch (FOREVER_ANY_PORTAL in client/macos/keypatch.c). CERTS_DIR is a host folder holding the
#    certificate's full chain (CERT_FILE) and its key (KEY_FILE), e.g. Let's Encrypt's fullchain.pem and privkey.pem.
#    Real files, not symlinks into another folder (the container can't follow those).
#LOGIN_HOSTNAME=login.realm.example.com
#CERTS_DIR=/path/to/certificate/files
#CERT_FILE=fullchain.pem
#KEY_FILE=privkey.pem

# Patched client build for players' test copies (cdn service, docs/custom-files.md): where cdn-build writes it and the
# port it is served on. Players point their Mac at it with: everlake-client.sh cdn <server>:<port>
#CDN_FILES_DIR=./cdn-files   (file sets to add: folders with files named by FileDataID and a files.tsv)
#CDN_DIR=./cdn
#CDN_PORT=8087

# The PTR (docker-compose.ptr.yml) lets in GM accounts only: the Battle.net emails here (comma-separated) become GM
# level 3 on all realms when the PTR app starts (scripts/ptr-setup.sh gms). Empty: nobody is changed.
PTR_GM_EMAILS=
# The PTR's world import: empty uses the commit pinned in docker-compose.ptr.yml (WORLD_DATA_COMMIT above is the live realm's)
PTR_WORLD_DATA_COMMIT=

# Realm 1 and the login server run everlake-trinitycore:live; a tried PTR image becomes live with
# "sudo scripts/promote.sh" (README, PTR), so leave EVERLAKE_IMAGE_TAG unset: a value here wins over the live tag.
# Realm 2 keeps REALM2_IMAGE_TAG (default latest).
EVERLAKE_IMAGE_TAG=
REALM2_IMAGE_TAG=

# Live bots (docker-compose.yml; the PTR sets its own few). Empty = the default in brackets. These win over
# overrides/playerbot.conf.
#   BOTS_MAX         world bots in total [500]
#   BOTS_RSS_BUDGET_MB  worldserver memory (MB) at which no more bots spawn [32000]
#   BOTS_GLOBAL_FILL 1: bots no player needs wait in towns and quest hubs all over the world; 0: only near players [1]
#   BOTS_ZONE / BOTS_CITY / BOTS_START_ZONE / BOTS_PER_PLAYER  bots within 600 y of each player in a leveling zone /
#                    a town / a start zone / anywhere else [30 / 80 / 15 / 40]
#   BOTS_AREA_CAP    most bots within 45 y of one another outdoors [8]
BOTS_MAX=
BOTS_RSS_BUDGET_MB=
BOTS_GLOBAL_FILL=
BOTS_ZONE=
BOTS_CITY=
BOTS_START_ZONE=
BOTS_PER_PLAYER=
BOTS_AREA_CAP=

# Dynamic respawns of quest targets and herb/ore nodes (live and PTR). Empty = the default in brackets.
#   RESPAWN_RATE_CREATURE / RESPAWN_RATE_OBJECT  players in a zone (bots count) before respawns speed up; twice this
#                    many = twice as fast [20 / 20]
#   RESPAWN_MIN_CREATURE / RESPAWN_MIN_OBJECT  shortest respawn in seconds [30 / 60]
RESPAWN_RATE_CREATURE=
RESPAWN_MIN_CREATURE=
RESPAWN_RATE_OBJECT=
RESPAWN_MIN_OBJECT=

# ForeverTracker (docker-compose.tracker.yml, docs/forever-tracker.md): its own TrueNAS app from this folder.
#   TRACKER_DB_PASSWORD     the MySQL user "tracker" (required; no quotes or backslashes)
#   TRACKER_ADMIN_PASSWORD  the website's local administrator (TRACKER_ADMIN_USER, default admin). Empty: only game
#                           masters (GM level 3+) can log in, with their Battle.net email and password
#   TRACKER_WORLD_DB / TRACKER_HOTFIXES_DB  what the analysis reads and the Forge writes [world_ptr / hotfixes_ptr];
#                           world / hotfixes: a report of live, the Forge only previews (the user can't write there)
#   TRACKER_PORT            website port on the host [8090]
#   TRACKER_PUBLIC          1: anyone who reaches the port can browse; 0: administrators only [0]
#   TRACKER_LOCATE          1: the locator runs after the first analysis (asks Wowhead's public tooltips, slowly) [1]
#   TRACKER_ATLASLOOT_EVERY_HOURS  hours between AtlasLoot checks on CurseForge; a new version = an import card [6; 0 = never]
#   TRACKER_ATLASLOOT_GUESS 0: AtlasLoot drops without a measured chance are left out instead of an even share [1]
#   TRACKER_COMMIT          buildthehomelab/wow-forever-tracker commit to build [the pin in docker-compose.tracker.yml]
#   TRACKER_BUILD_DB_PASSWORD  the MySQL user "tracker_build" of the world build (docs/forever-tracker.md): made when
#                           this is set, with rights on its scratch database only (no quotes or backslashes). Empty:
#                           no such user, no world build
#   TRACKER_BUILD_DB        the scratch database "tracker.py world replay" drops and rebuilds; a name that starts
#                           with ft_ [ft_world_build]
#   TRACKER_WORLD_IMAGE_TAG the everlake-trinitycore image whose files the replay reads [EVERLAKE_IMAGE_TAG, or
#                           live]; the PTR's: ptr-<core commit>-<world data commit>. It must exist on the server
TRACKER_DB_PASSWORD=
TRACKER_ADMIN_PASSWORD=
TRACKER_WORLD_DB=
TRACKER_HOTFIXES_DB=
TRACKER_PORT=
TRACKER_PUBLIC=
TRACKER_BUILD_DB_PASSWORD=
